{
  "version": 1,
  "updated": "2026-10-22",
  "note": "内置索引优先使用 qist/tvbox，并通过仓库文件树与文件名模式继续发现。App 会逐个下载、解析、抽样验证，只有验证通过的才写入配置并优先使用。",
  "local": [
    { "name": "qist/tvbox", "url": "https://raw.githubusercontent.com/qist/tvbox/master/jsm.json" }
  ],
  "sources": [],
  "github": {
    "enabled": true,
    "repos": [
      "qist/tvbox@master",
      "gaotianliuyun/gao@master"
    ],
    "queries": [
      "tvbox config in:name,description",
      "tvbox 接口 in:name,description",
      "tvbox json in:name,description",
      "catvod config in:name,description"
    ],
    "maxRepos": 8,
    "maxFilesPerRepo": 8,
    "guessFilenames": [
      "jsm.json",
      "0821.json",
      "0825.json",
      "0827.json",
      "dianshi.json",
      "config.json",
      "api.json",
      "tvbox.json",
      "single.json",
      "main.json",
      "tvbox_config.json",
      "json/config.json",
      "json/jsm.json",
      "color.json"
    ],
    "readmeCandidates": ["README.md", "readme.md", "README.txt"]
  },
  "probe": {
    "maxSitesPerConfig": 3,
    "budgetMs": 25000,
    "requestTimeoutSeconds": 8
  }
}
