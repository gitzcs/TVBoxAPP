<?xml version="1.0" encoding="utf-8"?>
<!-- 视频源自动获取 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40">

        <View
            android:layout_width="@dimen/vs_5"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@color/color_FFB800" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="视频源自动获取"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMerge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_10"
            android:background="@drawable/button_dialog_main"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/vs_12"
            android:text="合并到本地"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_10"
            android:background="@drawable/button_dialog_main"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/vs_12"
            android:text="立即刷新"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <!-- 状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_40"
        android:layout_marginRight="@dimen/vs_40"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vs_10">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <!-- 候选列表 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/finderList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/vs_20"
        android:layout_weight="1"
        android:padding="@dimen/vs_10"
        android:scrollbars="none" />

    <!-- 底部提示 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/vs_10"
        android:text="仅验证通过的源才会保存；含爬虫站的配置会额外提示"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_18" />
</LinearLayout>
