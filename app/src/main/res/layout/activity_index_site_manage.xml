<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索索引站管理 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40">

        <View
            android:layout_width="@dimen/vs_5"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@color/color_FFB800" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="搜索索引站"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnResetIndexSites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_10"
            android:background="@drawable/button_dialog_main"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/vs_12"
            android:text="恢复默认"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnRefreshIndexSites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_10"
            android:background="@drawable/button_dialog_main"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/vs_12"
            android:text="立即刷新"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnAddIndexSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_dialog_main"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/vs_12"
            android:text="＋ 新增站点"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/indexSiteList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/vs_20"
        android:layout_weight="1"
        android:padding="@dimen/vs_10"
        android:scrollbars="none" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/vs_10"
        android:text="索引站仅提供仓库搜索结果；停用后自动回退 GitHub 搜索"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_18" />
</LinearLayout>
