<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/vs_20"
            android:text="配置操作"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnActionSetHome"
            style="@style/ConfigActionButton"
            android:text="设为主页源" />

        <TextView
            android:id="@+id/btnActionEdit"
            style="@style/ConfigActionButton"
            android:text="编辑配置" />

        <TextView
            android:id="@+id/btnActionToggleEnabled"
            style="@style/ConfigActionButton"
            android:text="停用配置" />

        <TextView
            android:id="@+id/btnActionDelete"
            style="@style/ConfigActionButton"
            android:text="删除配置"
            android:textColor="@color/color_FFB800" />

        <TextView
            android:id="@+id/btnActionCancel"
            style="@style/ConfigActionButton"
            android:text="取消" />
    </LinearLayout>
</FrameLayout>
