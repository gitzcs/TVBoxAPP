<?xml version="1.0" encoding="utf-8"?>
<!-- 缓存添加成功弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_25">

    <TextView
        android:id="@+id/tipInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="已添加缓存列表"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_26"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnJumpCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/button_danmu_setting"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/vs_12"
        android:text="跳转缓存页"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/btnKnow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:background="@drawable/button_danmu_setting"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/vs_12"
        android:text="知道了"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22" />
</LinearLayout>
