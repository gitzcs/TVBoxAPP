<?xml version="1.0" encoding="utf-8"?>
<!-- 离线缓存管理 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_60"
            android:layout_marginTop="@dimen/vs_20"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/vs_5"
                android:layout_height="@dimen/vs_40"
                android:layout_marginEnd="@dimen/vs_15"
                android:layout_marginRight="@dimen/vs_15"
                android:background="@color/color_FFB800" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="离线缓存"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_28"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCacheSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_3"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnBackGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_10"
                android:layout_marginRight="@dimen/vs_10"
                android:background="@drawable/button_dialog_main"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_10"
                android:text="← 返回列表"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_dialog_vod"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_10"
                android:text="清空全部"
                android:textColor="@color/color_FFB800"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/cacheList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_15"
            android:layout_weight="1"
            android:padding="@dimen/vs_5"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="暂无缓存任务\n在视频详情页点击「缓存」即可离线下载"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_22"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>