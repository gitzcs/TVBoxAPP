<?xml version="1.0" encoding="utf-8"?>
<!-- 找源候选条目 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/vs_8"
    android:background="@drawable/shape_setting_model_focus"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/vs_15">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/vs_15"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFinderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFinderUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/tvFinderInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFinderState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/vs_10"
        android:background="@drawable/button_dialog_main"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/vs_10"
        android:text="验证中"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />

    <TextView
        android:id="@+id/btnFinderUse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_dialog_main"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/vs_10"
        android:text="使用"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />
</LinearLayout>
