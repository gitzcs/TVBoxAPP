<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索索引站新增/编辑对话框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="新增索引站"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputIndexSiteName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/input_dialog_api_input"
        android:hint="站点名称 (如: bdnb.cn)"
        android:inputType="text"
        android:maxLines="1"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/dialog_text_hint"
        android:textSize="@dimen/ts_22" />

    <EditText
        android:id="@+id/inputIndexSiteUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:background="@drawable/input_dialog_api_input"
        android:hint="站点地址，https://..."
        android:inputType="textUri"
        android:maxLines="1"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/dialog_text_hint"
        android:textSize="@dimen/ts_22" />

    <EditText
        android:id="@+id/inputIndexSiteQueries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:background="@drawable/input_dialog_api_input"
        android:gravity="top|start"
        android:hint="搜索关键词，每行一个"
        android:inputType="textMultiLine"
        android:maxLines="7"
        android:minLines="4"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/dialog_text_hint"
        android:textSize="@dimen/ts_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启用该索引站"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnIndexSiteToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_danmu_setting"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/vs_10"
            android:text="已启用"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnIndexSiteCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_12"
            android:text="取消"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnIndexSiteSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_15"
            android:layout_marginStart="@dimen/vs_15"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_12"
            android:text="保存"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>
